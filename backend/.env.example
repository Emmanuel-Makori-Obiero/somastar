# Copy to backend/.env and fill in. Never commit the real .env.
ENV=development
DATABASE_URL=sqlite:///./somastar.db

# REQUIRED in production: 32+ random chars.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me

CORS_ORIGINS=http://localhost:5173

# AI provider(s). One name, or a fallback chain tried left to right:
#   gemini            -> Gemini only
#   anthropic,gemini  -> Claude first, Gemini if Claude fails
#   mock              -> fake data, never reads your file (offline UI testing only)
# No quotes, no spaces around "=". Restart uvicorn after any change to this file.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# One model, or several separated by commas: tried in order if one is overloaded/unavailable.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.6-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Dev only: show the technical error on failed analyses. Must be off in production.
DEBUG_ERRORS=false

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_MB=10